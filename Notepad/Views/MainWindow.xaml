<Window x:Class="Notepad.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppTitle}"
        Height="700" Width="1050"
        MinHeight="500" MinWidth="780"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="PlaceholderTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Tag" Value=""/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <TextBlock x:Name="Placeholder"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="#B0BAC8"
                                       FontSize="{TemplateBinding FontSize}"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Top"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" Background="{StaticResource PrimaryBrush}"
                            CornerRadius="8" Margin="0,0,10,0">
                        <TextBlock Text="📝" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{DynamicResource AppTitle}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding NewNoteCommand}"
                            Padding="14,7" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+" FontSize="16" FontWeight="Bold" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource NewNote}" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModernButton}" Command="{Binding SaveNoteCommand}"
                            Padding="14,7" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource SaveNote}" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModernButton}" Command="{Binding UndoNoteCommand}"
                            Padding="14,7" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↩" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource UndoNote}" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DangerButton}" Command="{Binding DeleteNoteCommand}"
                            Padding="14,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource DeleteNote}" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ModernButton}" Padding="10,5" Margin="0,0,4,0"
                            Command="{Binding ChangeLanguageCommand}" CommandParameter="en">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🇬🇧" FontSize="14" Margin="0,0,4,0"/>
                            <TextBlock Text="EN" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModernButton}" Padding="10,5"
                            Command="{Binding ChangeLanguageCommand}" CommandParameter="uk">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🇺🇦" FontSize="14" Margin="0,0,4,0"/>
                            <TextBlock Text="УК" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Background="White"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="10,10,10,8" Background="#F3F4F6" CornerRadius="8" Padding="8,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" Opacity="0.5" Margin="0,0,6,0"/>
                            <TextBox Style="{StaticResource PlaceholderTextBox}"
                                     Tag="{DynamicResource SearchPlaceholder}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="13" VerticalAlignment="Center" Width="158"
                                     Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding FilteredNotes}"
                             SelectedItem="{Binding SelectedNote}"
                             SelectionChanged="NotesList_SelectionChanged"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Padding="4">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource NoteListItem}"/>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding Title}" FontWeight="SemiBold"
                                               FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="1" Text="{Binding Content}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" Opacity="0.8"
                                               Margin="0,2,0,0" MaxHeight="32"/>
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding ModifiedAt, StringFormat='{}{0:MMM d, HH:mm}'}"
                                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,3,0,0" Opacity="0.6"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- RIGHT EDITOR -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- FORMATTING TOOLBAR -->
                <Border Grid.Row="0" Background="{StaticResource ToolbarBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                        Padding="12,6" IsEnabled="{Binding HasSelectedNote}">
                    <WrapPanel VerticalAlignment="Center">

                        <TextBlock Text="{DynamicResource FontFamily}" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Style="{StaticResource ModernComboBox}" Width="140" Margin="0,0,12,0"
                                  ItemsSource="{Binding FontFamilies}"
                                  SelectedItem="{Binding NoteFontFamily}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="12"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="{DynamicResource FontSize}" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Style="{StaticResource ModernComboBox}" Width="65" Margin="0,0,12,0"
                                  ItemsSource="{Binding FontSizes}"
                                  SelectedItem="{Binding NoteFontSize}"/>

                        <Separator Width="1" Height="24" Background="{StaticResource BorderBrush}" Margin="0,0,8,0"/>

                        <ToggleButton Style="{StaticResource FormatToggleButton}"
                                      IsChecked="{Binding NoteIsBold}"
                                      ToolTip="{DynamicResource Bold}" Margin="2,0">
                            <TextBlock Text="B" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </ToggleButton>

                        <ToggleButton Style="{StaticResource FormatToggleButton}"
                                      IsChecked="{Binding NoteIsItalic}"
                                      ToolTip="{DynamicResource Italic}" Margin="2,0">
                            <TextBlock Text="I" FontStyle="Italic" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </ToggleButton>

                        <ToggleButton Style="{StaticResource FormatToggleButton}"
                                      IsChecked="{Binding NoteIsUnderline}"
                                      ToolTip="{DynamicResource Underline}" Margin="2,0">
                            <TextBlock Text="U" FontSize="14" TextDecorations="Underline" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </ToggleButton>

                        <Separator Width="1" Height="24" Background="{StaticResource BorderBrush}" Margin="8,0"/>

                        <TextBlock Text="{DynamicResource TextColor}" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>

                        <ItemsControl ItemsSource="{Binding TextColors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="22" Height="22" Cursor="Hand" Margin="2,0"
                                            Command="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Hex}"
                                            ToolTip="{Binding Name}"
                                            BorderThickness="0" Padding="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{Binding Brush}" CornerRadius="11" Width="18" Height="18">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="BorderBrush" Value="White"/>
                                                                    <Setter Property="BorderThickness" Value="2"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>
                </Border>

                <!-- TITLE -->
                <Border Grid.Row="1" Background="White" Padding="24,16,24,8">
                    <TextBox Style="{StaticResource PlaceholderTextBox}"
                             Tag="{DynamicResource NoteTitlePlaceholder}"
                             Text="{Binding NoteTitle, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="22" FontWeight="Bold"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             IsEnabled="{Binding HasSelectedNote}"/>
                </Border>

                <!-- EDITOR -->
                <Border Grid.Row="2" Background="White" Padding="24,4,24,12">
                    <Grid>
                        <TextBlock Text="{DynamicResource NoNoteSelected}"
                                   FontSize="16" Foreground="#C0C8D4"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedNote}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Bind directly to typed VM properties - NO converters -->
                        <TextBox x:Name="NoteEditor"
                                 Style="{StaticResource PlaceholderTextBox}"
                                 Tag="{DynamicResource NoteContentPlaceholder}"
                                 Text="{Binding NoteContent, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="NoteEditor_TextChanged"
                                 AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 IsEnabled="{Binding HasSelectedNote}"
                                 FontFamily="{Binding NoteFontFamily}"
                                 FontSize="{Binding NoteFontSize}"
                                 FontWeight="{Binding NoteFontWeight}"
                                 FontStyle="{Binding NoteFontStyle}"
                                 TextDecorations="{Binding NoteTextDecoration}"
                                 Foreground="{Binding NoteTextBrush}"
                                 SpellCheck.IsEnabled="True"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="{StaticResource ToolbarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}" FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center" Margin="16,0"/>
        </Border>
    </Grid>
</Window>
